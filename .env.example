# Copy this file to .env. Never commit .env or paste a key into chat.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HEARTHWOOD_PORT=8004

# Optional email connection. Use a mailbox-specific app password where supported.
# Port 587 uses STARTTLS; port 465 uses implicit TLS. No plaintext mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Configure only verified department mailboxes. No addresses are guessed.
TEAM_EMAIL_PRODUCT_SAFETY=
TEAM_EMAIL_DAMAGED_ITEM=
TEAM_EMAIL_LATE_DELIVERY=
TEAM_EMAIL_MISSING_PARTS=
TEAM_EMAIL_WRONG_ITEM=
TEAM_EMAIL_REFUND_DELAY=
TEAM_EMAIL_ASSEMBLY_HELP=
TEAM_EMAIL_UNCLEAR=
